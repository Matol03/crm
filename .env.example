# Where finished leads go:
#   platform - this service's own store, shown on the dashboard (no portal needed)
#   bitrix   - written to the Bitrix24 portal via BITRIX_WEBHOOK_URL
#   both     - stored locally AND mirrored to the portal; the local write is
#              primary, so a portal outage degrades the mirror, never the lead
LEAD_SINK=both
# ─────────────────────────────────────────────────────────────
# Trade-Show Lead Processing Service — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Placeholders only in this file.
# ─────────────────────────────────────────────────────────────

# ── Run modes ────────────────────────────────────────────────
# mock | live  — controls whether the real Bitrix portal is written to.
# Stays `mock` until mock-mode tests pass and going live is explicitly approved.
BITRIX_MODE=mock
# mock | live  — Microsoft Graph ingestion (real Graph deferred; Q2 skipped).
MSGRAPH_MODE=mock
# mock | live  — LLM extraction/segmentation.
LLM_MODE=mock
# mock | live  — ASR transcription (real provider deferred; Q3 skipped).
ASR_MODE=live
# fixture | live | none — real card OCR (provider below).
OCR_MODE=fixture
# LLM / OCR provider when the corresponding mode is `live`: gemini | deepseek.
# Gemini is free-tier and does both text + vision; DeepSeek needs account balance.
LLM_PROVIDER=gemini
OCR_PROVIDER=gemini

# ── Bitrix24 ─────────────────────────────────────────────────
# The webhook URL *is* the credential. Never log it, never return it, never commit it.
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/<user_id>/<token>/
# Fallback owner when a Teams author has no employee_map entry.
BITRIX_DEFAULT_OWNER_ID=1
# STATUS_ID for newly created leads (add only, never on update).
BITRIX_INITIAL_STATUS_ID=NEW

# ── Gemini (free tier: LLM extraction/segmentation + vision OCR) ─
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash

# ── DeepSeek (alternate LLM + vision OCR; needs account balance) ─
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# ── Microsoft Graph (deferred — mock until creds provided) ───
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TEAMS_GROUP_ID=
GRAPH_CHANNEL_ID=

# ── ASR (deferred — mock until provider confirmed) ──────────
ASR_PROVIDER=gemini
ASR_API_KEY=

# ── Pipeline tuning (non-blocking defaults) ─────────────────
IDLE_TIMEOUT_MS=240000          # 4 min per-author silence closes a session
MAX_SESSION_DURATION_MS=900000  # 15 min hard cap regardless of activity
POLL_INTERVAL_MS=20000          # Graph poll cadence
CONFIDENCE_THRESHOLD=0.6        # fields below this are written as null
BITRIX_RATE_LIMIT_PER_SEC=2     # global token bucket
BITRIX_BATCH_SIZE=13            # ~50 sub-calls per batch request

# ── Campaign constants (applied to every lead this period) ──
CAMPAIGN_EXHIBITION=Hannover Messe 2026
CAMPAIGN_SOURCE=Trade Show

# ── Storage / server ────────────────────────────────────────
DB_PATH=./data/lead-service.sqlite
API_PORT=4318
API_SHARED_SECRET=change-me-dev-only
